      },
      {
        "text": "Keliling sebenarnya.",
        "expr": "24 × 2 = 48 m"
      }
    ],
    "describe": "p = |5 − (−3)|; l = |3 − (−1)|; L = p × l; K = 2 × (p + l); 1 satuan = 2 m"
  },
